// apt.amberlinux.org — see docs/DEPLOY.md. Metadata (dists/, keyring,
// index.html) is served as static assets, byte-exact (html_handling
// "none" is the point); pool/** exceeds the 25 MiB asset cap and is
// served from R2 by the worker.
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "amberlinux-apt",
  "compatibility_date": "2026-06-21",
  "main": "worker.js",
  "assets": {
    "binding": "ASSETS",
    "directory": "../out",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true,
  },
  "r2_buckets": [
    { "binding": "POOL", "bucket_name": "amberlinux-apt-pool" },
  ],
  "routes": [
    { "pattern": "apt.amberlinux.org", "custom_domain": true },
  ],
}
